{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the three How Is It windows",
  "windows": ["main", "popover", "widget"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "liquid-glass:default",
    "notification:default",
    "autostart:default",
    "positioner:default"
  ]
}
